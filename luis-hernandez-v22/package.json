{
  "name": "luis-hernandez-v22",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host localhost --port 4200",
    "build": "ng build --configuration production --base-href /",
    "postbuild": "node scripts/postbuild.mjs",
    "preview": "http-server dist/luis-hernandez-v22/browser -a localhost -p 4300 -c-1",
    "test:e2e": "playwright test",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "verify": "npm run test -- --watch=false && npm run typecheck:e2e && npm run build && npm run test:e2e",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@angular/material": "22.2.5",
    "@angular/cdk": "22.2.5",
    "@fortawesome/angular-fontawesome": "5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@playwright/test": "^1.56.0",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^26.0.0",
    "http-server": "^14.1.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
